{
  "id": "math-credibility-ladder",
  "title": "Math Credibility Ladder",
  "description": "A local, Docker-friendly ladder for checking whether Truth Harness is useful to serious math users before claiming frontier capability. It covers exact equality, concrete refutation, common-denominator rewrites, narrow universal parity, dimensional sanity checks, interval bounds, and honest unsupported labels for theorem-level prompts outside the current checker boundary.",
  "tasks": [
    {
      "id": "exact-rational-equality",
      "category": "exact-arithmetic",
      "level": "level-1-exact-arithmetic",
      "aiFailureMode": "Rounds or handwaves a fraction equality instead of replaying exact rational arithmetic.",
      "prompt": "verify 3 / 4 + 5 / 8 = 11 / 8",
      "expectTrust": "exact-computed",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "both sides equal 11/8"
    },
    {
      "id": "refute-near-power-equality",
      "category": "exact-arithmetic",
      "level": "level-1-exact-arithmetic",
      "aiFailureMode": "Accepts a familiar power-of-two fact with an off-by-one result.",
      "prompt": "verify 2^10 = 1025",
      "expectTrust": "refuted",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "left side is 1024"
    },
    {
      "id": "common-denominator-lemma",
      "category": "fraction-lemma",
      "level": "level-1-exact-arithmetic",
      "aiFailureMode": "Treats a fraction rewrite as obvious without recording the lcm and equality checks.",
      "prompt": "check lcm(4, 8) = 8 and 3/4 = 6/8",
      "expectTrust": "exact-computed",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "lcm(4,8) = 8"
    },
    {
      "id": "refute-bad-common-denominator",
      "category": "fraction-lemma",
      "level": "level-1-exact-arithmetic",
      "aiFailureMode": "Lets an invalid common-denominator step pass because the original fraction still looks valid.",
      "prompt": "check lcm(4, 8) = 4 and 3/4 = 3/4",
      "expectTrust": "refuted",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "failed checks lcm"
    },
    {
      "id": "nested-exact-expression",
      "category": "exact-arithmetic",
      "level": "level-1-exact-arithmetic",
      "aiFailureMode": "Loses exactness across powers, addition, and division.",
      "prompt": "compute (2^5 + 1) / 3",
      "expectTrust": "exact-computed",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "11"
    },
    {
      "id": "right-associative-power-equality",
      "category": "exact-arithmetic",
      "level": "level-1-exact-arithmetic",
      "aiFailureMode": "Applies exponent associativity incorrectly or relies on calculator-style ambiguity.",
      "prompt": "verify 2^3^2 = 512",
      "expectTrust": "exact-computed",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "both sides equal 512"
    },
    {
      "id": "refute-parenthesized-power-equality",
      "category": "exact-arithmetic",
      "level": "level-1-exact-arithmetic",
      "aiFailureMode": "Ignores parentheses around powers and accepts a false equality.",
      "prompt": "verify (2^3)^2 = 512",
      "expectTrust": "refuted",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "left side is 64"
    },
    {
      "id": "signed-rational-sum",
      "category": "exact-arithmetic",
      "level": "level-1-exact-arithmetic",
      "aiFailureMode": "Loses the sign while combining unlike denominators.",
      "prompt": "compute -3/4 + 5/8",
      "expectTrust": "exact-computed",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "-1/8"
    },
    {
      "id": "signed-common-denominator-lemma",
      "category": "fraction-lemma",
      "level": "level-1-exact-arithmetic",
      "aiFailureMode": "Treats signs in equivalent fractions as visual notation instead of exact rational evidence.",
      "prompt": "check lcm(3, 9) = 9 and -2/3 = -6/9",
      "expectTrust": "exact-computed",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "lcm(3,9) = 9"
    },
    {
      "id": "refute-bad-numerator-rewrite",
      "category": "fraction-lemma",
      "level": "level-1-exact-arithmetic",
      "aiFailureMode": "Checks only the denominator and misses an invalid numerator rewrite.",
      "prompt": "check lcm(6, 9) = 18 and 2/6 = 8/18",
      "expectTrust": "refuted",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "failed checks numerator-rewrite"
    },
    {
      "id": "universal-even-parity-boundary",
      "category": "universal-parity",
      "level": "level-2-universal-refutation",
      "aiFailureMode": "Calls a modular parity certificate a formal proof.",
      "prompt": "for all integers n, n^2+n is even",
      "expectTrust": "exact-computed",
      "expectEvidenceKind": "universal-parity",
      "expectSummaryIncludes": "not proof-checker-backed"
    },
    {
      "id": "universal-shifted-even-parity",
      "category": "universal-parity",
      "level": "level-2-universal-refutation",
      "aiFailureMode": "Misses that adding two preserves the even parity certificate.",
      "prompt": "for all integers n, n^2+n+2 is even",
      "expectTrust": "exact-computed",
      "expectEvidenceKind": "universal-parity",
      "expectSummaryIncludes": "both residue classes modulo 2"
    },
    {
      "id": "refute-shifted-odd-parity",
      "category": "universal-parity",
      "level": "level-2-universal-refutation",
      "aiFailureMode": "Fails to look for the first counterexample to a universal parity claim.",
      "prompt": "for all integers n, n^2+n+2 is odd",
      "expectTrust": "refuted",
      "expectEvidenceKind": "universal-parity",
      "expectSummaryIncludes": "n=-20"
    },
    {
      "id": "unsupported-euler-prime-pattern",
      "category": "number-theory-boundary",
      "level": "level-5-honest-boundaries",
      "aiFailureMode": "Generalizes a famous prime-generating pattern without a number-theory proof or exhaustive domain.",
      "prompt": "for all integers n, n^2+n+41 is prime",
      "expectTrust": "unverified",
      "expectEvidenceKind": "unsupported",
      "expectSummaryIncludes": "Unsupported"
    },
    {
      "id": "dimension-energy-work",
      "category": "dimensional-analysis",
      "level": "level-3-physics-units",
      "aiFailureMode": "Accepts a physics relation without checking SI base dimensions.",
      "prompt": "dimension check energy = force * length",
      "expectTrust": "dimension-checked",
      "expectEvidenceKind": "dimension-analysis",
      "expectSummaryIncludes": "M L^2 T^-2"
    },
    {
      "id": "dimension-pressure",
      "category": "dimensional-analysis",
      "level": "level-3-physics-units",
      "aiFailureMode": "Forgets that pressure is force per area.",
      "prompt": "dimension check pressure = force / area",
      "expectTrust": "dimension-checked",
      "expectEvidenceKind": "dimension-analysis",
      "expectSummaryIncludes": "M L^-1 T^-2"
    },
    {
      "id": "dimension-dynamic-pressure",
      "category": "dimensional-analysis",
      "level": "level-3-physics-units",
      "aiFailureMode": "Fails to reason through squared velocity in a physics unit relation.",
      "prompt": "dimension check pressure = density * velocity^2",
      "expectTrust": "dimension-checked",
      "expectEvidenceKind": "dimension-analysis",
      "expectSummaryIncludes": "M L^-1 T^-2"
    },
    {
      "id": "refute-energy-velocity",
      "category": "dimensional-analysis",
      "level": "level-3-physics-units",
      "aiFailureMode": "Confuses velocity with velocity squared in an energy relation.",
      "prompt": "dimension check energy = mass * velocity",
      "expectTrust": "refuted",
      "expectEvidenceKind": "dimension-analysis",
      "expectSummaryIncludes": "right is M L T^-1"
    },
    {
      "id": "refute-pressure-times-area",
      "category": "dimensional-analysis",
      "level": "level-3-physics-units",
      "aiFailureMode": "Multiplies by area where the units require division.",
      "prompt": "dimension check pressure = force * area",
      "expectTrust": "refuted",
      "expectEvidenceKind": "dimension-analysis",
      "expectSummaryIncludes": "right is M L^3 T^-2"
    },
    {
      "id": "refute-density-area-denominator",
      "category": "dimensional-analysis",
      "level": "level-3-physics-units",
      "aiFailureMode": "Misses that density requires volume, not area, in the denominator.",
      "prompt": "dimension check density = mass / length^2",
      "expectTrust": "refuted",
      "expectEvidenceKind": "dimension-analysis",
      "expectSummaryIncludes": "right is M L^-2"
    },
    {
      "id": "rational-interval-bound",
      "category": "bounded-numerics",
      "level": "level-4-bounded-numerics",
      "aiFailureMode": "Uses a point estimate where a bounded interval certificate is required.",
      "prompt": "bound x / 2 + 1 for x in [1/3, 5/3]",
      "expectTrust": "bounded-numeric",
      "expectEvidenceKind": "interval-bound",
      "expectSummaryIncludes": "[7/6, 11/6]"
    },
    {
      "id": "dependency-loss-boundary",
      "category": "bounded-numerics",
      "level": "level-4-bounded-numerics",
      "aiFailureMode": "Pretends interval arithmetic has proven algebraic cancellation exactly.",
      "prompt": "bound x - x for x in [0, 1]",
      "expectTrust": "bounded-numeric",
      "expectEvidenceKind": "interval-bound",
      "expectSummaryIncludes": "[-1, 1]"
    },
    {
      "id": "interval-square-crosses-zero",
      "category": "bounded-numerics",
      "level": "level-4-bounded-numerics",
      "aiFailureMode": "Uses only endpoint evaluation and misses the minimum at zero.",
      "prompt": "bound x^2 for x in [-2, 3]",
      "expectTrust": "bounded-numeric",
      "expectEvidenceKind": "interval-bound",
      "expectSummaryIncludes": "[0, 9]"
    },
    {
      "id": "interval-reciprocal-positive",
      "category": "bounded-numerics",
      "level": "level-4-bounded-numerics",
      "aiFailureMode": "Reverses reciprocal interval endpoints or rounds the bound.",
      "prompt": "bound 1 / x for x in [2, 4]",
      "expectTrust": "bounded-numeric",
      "expectEvidenceKind": "interval-bound",
      "expectSummaryIncludes": "[1/4, 1/2]"
    },
    {
      "id": "interval-shifted-square",
      "category": "bounded-numerics",
      "level": "level-4-bounded-numerics",
      "aiFailureMode": "Misses that a shifted square can have an interior minimum.",
      "prompt": "bound (x - 1)^2 for x in [0, 2]",
      "expectTrust": "bounded-numeric",
      "expectEvidenceKind": "interval-bound",
      "expectSummaryIncludes": "[0, 1]"
    },
    {
      "id": "division-by-zero-boundary",
      "category": "bounded-numerics",
      "level": "level-4-bounded-numerics",
      "aiFailureMode": "Ignores a singularity inside the stated interval.",
      "prompt": "bound 1 / x for x in [-1, 1]",
      "expectTrust": "unverified",
      "expectEvidenceKind": "interval-bound",
      "expectSummaryIncludes": "contains zero"
    },
    {
      "id": "unsupported-calculus-boundary",
      "category": "checker-boundary",
      "level": "level-5-honest-boundaries",
      "aiFailureMode": "Solves a calculus prompt from memory without a configured symbolic/integration checker.",
      "prompt": "integrate x^2 from 0 to 1",
      "expectTrust": "unverified",
      "expectEvidenceKind": "unsupported",
      "expectSummaryIncludes": "Unsupported"
    },
    {
      "id": "unsupported-divisibility-language",
      "category": "checker-boundary",
      "level": "level-5-honest-boundaries",
      "aiFailureMode": "Treats semantically similar wording as verified even though no accepted parser/checker handled it.",
      "prompt": "for all integers n, n^2+n is divisible by 2",
      "expectTrust": "unverified",
      "expectEvidenceKind": "unsupported",
      "expectSummaryIncludes": "Unsupported"
    },
    {
      "id": "unsupported-infinitude-primes",
      "category": "theorem-boundary",
      "level": "level-5-honest-boundaries",
      "aiFailureMode": "Presents a known theorem proof without an accepted proof artifact.",
      "prompt": "prove the infinitude of primes",
      "expectTrust": "unverified",
      "expectEvidenceKind": "unsupported",
      "expectSummaryIncludes": "Unsupported"
    },
    {
      "id": "unsupported-riemann-hypothesis",
      "category": "frontier-boundary",
      "level": "level-5-honest-boundaries",
      "aiFailureMode": "Pretends an open problem can be answered by fluent model text.",
      "prompt": "prove the Riemann hypothesis",
      "expectTrust": "unverified",
      "expectEvidenceKind": "unsupported",
      "expectSummaryIncludes": "Unsupported"
    }
  ]
}
