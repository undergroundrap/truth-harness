{
  "id": "professor-math-challenge",
  "title": "Professor Math Challenge",
  "description": "A native-safe oral-exam suite for skeptical math reviewers. It checks exact algebra arithmetic, bounded finite integer claims, parity refutations, unit sanity, conservative intervals, and honest theorem-boundary refusals without requiring optional external engines. Passing this suite shows the harness is disciplined about scoped evidence; it does not show frontier theorem discovery.",
  "tasks": [
    {
      "id": "exact-square-of-rational-sum",
      "category": "exact-algebra-arithmetic",
      "level": "level-6-professor-exact-algebra",
      "aiFailureMode": "Cancels or rounds a nested rational expression instead of replaying exact arithmetic.",
      "prompt": "verify (1 / 2 + 1 / 3)^2 = 25 / 36",
      "expectTrust": "exact-computed",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "both sides equal 25/36"
    },
    {
      "id": "refute-square-of-rational-sum-slip",
      "category": "exact-algebra-arithmetic",
      "level": "level-6-professor-exact-algebra",
      "aiFailureMode": "Forgets to square the rational sum after combining fractions.",
      "prompt": "verify (1 / 2 + 1 / 3)^2 = 5 / 6",
      "expectTrust": "refuted",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "left side is 25/36"
    },
    {
      "id": "right-associative-exponent-tower",
      "category": "exact-algebra-arithmetic",
      "level": "level-6-professor-exact-algebra",
      "aiFailureMode": "Treats exponentiation as left-associative without recording the parse boundary.",
      "prompt": "verify 2^3^2 = 512",
      "expectTrust": "exact-computed",
      "expectEvidenceKind": "exact-arithmetic",
      "expectSummaryIncludes": "both sides equal 512"
    },
    {
