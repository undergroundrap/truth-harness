{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truth-harness.local/schemas/lean-theorem-corpus.schema.json",
  "title": "Truth Harness Lean Theorem Corpus",
  "type": "object",
  "required": [
    "schemaVersion",
    "corpusId",
    "title",
    "description",
    "projectPath",
    "localOnly",
    "networkAccess",
    "sourceProject",
    "families",
    "trustBoundary",
    "escalationGates",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "truth-harness.lean-theorem-corpus.v0"
    },
    "corpusId": {
      "type": "string",
      "pattern": "^ltc_[a-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "projectPath": {
      "type": "string",
      "minLength": 1
    },
    "localOnly": {
      "const": true
    },
    "networkAccess": {
      "const": "none"
    },
    "sourceProject": {
      "type": "object",
      "required": ["toolchain", "lakefile", "mathlib"],
      "properties": {
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "lakefile": {
          "type": "string",
          "minLength": 1
        },
        "mathlib": {
          "enum": ["not-required", "planned", "required"]
        }
      },
      "additionalProperties": false
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "familyId",
          "title",
          "lane",
          "status",
          "trustCeiling",
          "sourcePaths",
          "declarationNames",
          "evidenceRequired",
          "nextAction"
        ],
        "properties": {
          "familyId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "lane": {
            "enum": ["core-lean", "planned-mathlib", "mathlib"]
          },
          "status": {
            "enum": ["template-ready", "needs-proof", "planned-mathlib", "needs-review"]
          },
          "trustCeiling": {
            "enum": ["proved-after-proof-check", "unverified", "none"]
          },
          "sourcePaths": {
            "$ref": "#/$defs/stringArray"
          },
          "declarationNames": {
            "$ref": "#/$defs/stringArray"
          },
          "evidenceRequired": {
            "$ref": "#/$defs/stringArray"
          },
          "nextAction": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "trustBoundary": {
      "type": "object",
      "required": [
        "corpusIsNotProof",
        "provedRequiresProofCheckRecord",
        "mathlibFamiliesRequirePinnedManifest",
        "externalReviewRequiredForFrontierClaims"
      ],
      "properties": {
        "corpusIsNotProof": {
          "const": true
        },
        "provedRequiresProofCheckRecord": {
          "const": true
        },
        "mathlibFamiliesRequirePinnedManifest": {
          "const": true
        },
        "externalReviewRequiredForFrontierClaims": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "escalationGates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gateId", "title", "requiredBefore", "evidenceRequired"],
        "properties": {
          "gateId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requiredBefore": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRequired": {
            "$ref": "#/$defs/stringArray"
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}