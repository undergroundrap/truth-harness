{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truth-harness.local/schemas/proof-check.schema.json",
  "title": "Truth Harness Proof Check Record",
  "type": "object",
  "required": [
    "schemaVersion",
    "checkId",
    "createdAt",
    "backend",
    "source",
    "status",
    "trust",
    "proofCheckerBacked",
    "localOnly",
    "networkAccess",
    "replay",
    "limitations",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "truth-harness.proof-check.v0"
    },
    "checkId": {
      "type": "string",
      "pattern": "^proof_[a-f0-9]{16}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "backend": {
      "type": "object",
      "required": ["id", "displayName", "adapter", "role", "acceptedProofChecker", "command", "args"],
      "properties": {
        "id": {
          "const": "lean"
        },
        "displayName": {
          "const": "Lean proof checker"
        },
        "adapter": {
          "const": "local-lean-subprocess"
        },
        "role": {
          "const": "proof-checker"
        },
        "acceptedProofChecker": {
          "const": true
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "$ref": "#/$defs/stringArray"
        },
        "version": {
          "type": "string"
        },
        "exitCode": {
          "type": ["integer", "null"]
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["path", "sha256", "byteLength"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 0
        },
        "declarationName": {
          "type": "string"
        },
        "declaration": {
          "$ref": "#/$defs/proofDeclaration"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "routeId": {
          "type": "string",
          "pattern": "^route_[a-f0-9]{16}$"
        },
        "obligationId": {
          "type": "string",
          "pattern": "^obl_[a-f0-9]{16}$"
        },
        "statementHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{16,64}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": ["accepted", "rejected", "backend-unavailable", "error"]
    },
    "trust": {
      "enum": ["proved", "unverified"]
    },
    "proofCheckerBacked": {
      "type": "boolean"
    },
    "localOnly": {
      "const": true
    },
    "networkAccess": {
      "const": "none"
    },
    "replay": {
      "type": "string",
      "minLength": 1
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "limitations": {
      "$ref": "#/$defs/stringArray"
    },
    "warnings": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "proofDeclaration": {
      "type": "object",
      "required": [
        "declarationId",
        "kind",
        "path",
        "line",
        "column",
        "signature",
        "signatureSha256",
        "sourceSha256"
      ],
      "properties": {
        "declarationId": {
          "type": "string",
          "pattern": "^decl_[a-f0-9]{16}$"
        },
        "kind": {
          "enum": ["theorem", "lemma", "example", "def"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "signature": {
          "type": "string",
          "minLength": 1
        },
        "signatureSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
