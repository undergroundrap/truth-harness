{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theorem-workbench.local/schemas/verifier-route.schema.json",
  "title": "Theorem Workbench Verifier Route",
  "type": "object",
  "required": [
    "schemaVersion",
    "routeId",
    "createdAt",
    "localOnly",
    "networkAccess",
    "problem",
    "normalizedProblem",
    "status",
    "finalTrust",
    "evidenceKind",
    "receipt",
    "replay",
    "manifest",
    "usedCapabilities",
    "blockedCapabilities",
    "plannedCapabilities",
    "gaps",
    "nextActions",
    "trustBoundary",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "theorem.verifier-route.v0"
    },
    "routeId": {
      "type": "string",
      "pattern": "^route_[a-f0-9]{16}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "localOnly": {
      "const": true
    },
    "networkAccess": {
      "const": "none"
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "normalizedProblem": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["verified", "refuted", "unverified"]
    },
    "finalTrust": {
      "$ref": "#/$defs/trustLabel"
    },
    "evidenceKind": {
      "$ref": "#/$defs/evidenceKind"
    },
    "receipt": {
      "type": "object",
      "required": ["schemaVersion", "runId", "trust", "evidenceProfile", "replay"],
      "properties": {
        "schemaVersion": {
          "const": "theorem.receipt.v0"
        },
        "runId": {
          "type": "string",
          "pattern": "^run_[a-f0-9]{16}$"
        },
        "trust": {
          "$ref": "#/$defs/trustLabel"
        },
        "evidenceProfile": {
          "type": "object",
          "required": ["kind", "replayable", "proofCheckerBacked", "backends"],
          "properties": {
            "kind": {
              "$ref": "#/$defs/evidenceKind"
            },
            "replayable": {
              "type": "boolean"
            },
            "proofCheckerBacked": {
              "type": "boolean"
            },
            "backends": {
              "type": "array"
            }
          }
        },
        "replay": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replay": {
      "type": "string",
      "minLength": 1
    },
    "manifest": {
      "type": "object",
      "required": [
        "schemaVersion",
        "status",
        "readyCount",
        "totalCount",
        "nativeCount",
        "adapterCount",
        "plannedCount"
      ],
      "properties": {
        "schemaVersion": {
          "const": "theorem.engine-manifest.v0"
        },
        "status": {
          "enum": ["ready", "partial", "missing"]
        },
        "readyCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalCount": {
          "type": "integer",
          "minimum": 0
        },
        "nativeCount": {
          "type": "integer",
          "minimum": 0
        },
        "adapterCount": {
          "type": "integer",
          "minimum": 0
        },
        "plannedCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "usedCapabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routeStep"
      }
    },
    "blockedCapabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routeStep"
      }
    },
    "plannedCapabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routeStep"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/routeGap"
      }
    },
    "proofObligations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proofObligation"
      }
    },
    "nextActions": {
      "$ref": "#/$defs/stringArray"
    },
    "trustBoundary": {
      "type": "object",
      "required": [
        "aiOutputIsNotEvidence",
        "statusProbeIsNotEvidence",
        "claimTrustRequiresResolvableEvidence",
        "provedRequiresAcceptedProofCheckerRun",
        "smtCheckedRequiresConcreteSolverRun",
        "crossCheckedRequiresIndependentAgreementRun",
        "routeIsNotProof",
        "receiptTrustIsUpperBound"
      ],
      "properties": {
        "aiOutputIsNotEvidence": {
          "const": true
        },
        "statusProbeIsNotEvidence": {
          "const": true
        },
        "claimTrustRequiresResolvableEvidence": {
          "const": true
        },
        "provedRequiresAcceptedProofCheckerRun": {
          "const": true
        },
        "smtCheckedRequiresConcreteSolverRun": {
          "const": true
        },
        "crossCheckedRequiresIndependentAgreementRun": {
          "const": true
        },
        "routeIsNotProof": {
          "const": true
        },
        "receiptTrustIsUpperBound": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "warnings": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "trustLabel": {
      "enum": [
        "proved",
        "exact-computed",
        "bounded-numeric",
        "smt-checked",
        "dimension-checked",
        "source-cited",
        "cross-checked",
        "unverified",
        "refuted"
      ]
    },
    "evidenceKind": {
      "enum": [
        "exact-arithmetic",
        "universal-parity",
        "dimension-analysis",
        "symbolic-cas",
        "interval-bound",
        "source-citation",
        "unsupported"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routeStep": {
      "type": "object",
      "required": [
        "capabilityId",
        "displayName",
        "status",
        "capabilityStatus",
        "strongestTrust",
        "canMintTrust",
        "reason"
      ],
      "properties": {
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["used", "blocked", "planned"]
        },
        "capabilityStatus": {
          "enum": ["ready", "available", "missing", "error", "planned"]
        },
        "strongestTrust": {
          "enum": [
            "proved",
            "exact-computed",
            "bounded-numeric",
            "smt-checked",
            "dimension-checked",
            "source-cited",
            "cross-checked",
            "unverified",
            "refuted",
            "provenance-only",
            "validation-plan",
            "none"
          ]
        },
        "canMintTrust": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string"
        },
        "nextStep": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "routeGap": {
      "type": "object",
      "required": ["capabilityId", "displayName", "severity", "reason"],
      "properties": {
        "capabilityId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": ["info", "warning", "critical"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string"
        },
        "nextStep": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "proofObligation": {
      "type": "object",
      "required": [
        "obligationId",
        "kind",
        "status",
        "severity",
        "sourceCapabilityId",
        "title",
        "statement",
        "requiredBefore",
        "acceptanceCriteria"
      ],
      "properties": {
        "obligationId": {
          "type": "string",
          "pattern": "^obl_[a-f0-9]{16}$"
        },
        "kind": {
          "enum": ["formal-proof", "independent-check", "solver-encoding", "reproducibility"]
        },
        "status": {
          "enum": ["open", "satisfied", "not-required"]
        },
        "severity": {
          "enum": ["info", "warning", "critical"]
        },
        "sourceCapabilityId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "requiredBefore": {
          "type": "string",
          "minLength": 1
        },
        "acceptanceCriteria": {
          "$ref": "#/$defs/stringArray"
        },
        "command": {
          "type": "string"
        },
        "nextStep": {
          "type": "string"
        },
        "satisfiedBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "satisfiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "satisfactionSummary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": {
          "enum": ["cas", "proof", "smt", "receipt", "route"]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "trust": {
          "$ref": "#/$defs/trustLabel"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
