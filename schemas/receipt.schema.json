{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theorem-workbench.local/schemas/receipt.schema.json",
  "title": "Theorem Workbench Receipt",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "createdAt",
    "problem",
    "normalizedProblem",
    "trust",
    "summary",
    "replay",
    "privacy",
    "evidenceProfile",
    "graph",
    "artifacts",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "theorem.receipt.v0"
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[a-f0-9]{16}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "problem": {
      "type": "string"
    },
    "normalizedProblem": {
      "type": "string"
    },
    "trust": {
      "$ref": "#/$defs/trustLabel"
    },
    "summary": {
      "type": "string"
    },
    "replay": {
      "type": "string"
    },
    "privacy": {
      "$ref": "#/$defs/privacyMetadata"
    },
    "evidenceProfile": {
      "$ref": "#/$defs/receiptEvidenceProfile"
    },
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graphNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceEdge"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "trustLabel": {
      "enum": [
        "proved",
        "exact-computed",
        "bounded-numeric",
        "smt-checked",
        "dimension-checked",
        "source-cited",
        "cross-checked",
        "unverified",
        "refuted"
      ]
    },
    "nodeKind": {
      "enum": [
        "problem",
        "normalized_problem",
        "claim",
        "plan",
        "tool_run",
        "proof",
        "computation",
        "counterexample",
        "source",
        "explanation",
        "lesson",
        "artifact"
      ]
    },
    "privacyMetadata": {
      "type": "object",
      "required": ["mode", "localFirst", "networkAccess", "dataResidency", "externalDisclosures"],
      "properties": {
        "mode": {
          "enum": ["local-only", "external-calls"]
        },
        "localFirst": {
          "type": "boolean"
        },
        "networkAccess": {
          "enum": ["none", "optional", "required"]
        },
        "dataResidency": {
          "const": "local-workspace"
        },
        "externalDisclosures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalDisclosure"
          }
        }
      }
    },
    "externalDisclosure": {
      "type": "object",
      "required": ["service", "purpose", "dataClasses", "userInitiated"],
      "properties": {
        "service": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "dataClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "userInitiated": {
          "type": "boolean"
        }
      }
    },
    "receiptEvidenceProfile": {
      "type": "object",
      "required": [
        "kind",
        "backends",
        "inputs",
        "outputs",
        "replayable",
        "proofCheckerBacked",
        "limitations"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exact-arithmetic",
            "universal-parity",
            "dimension-analysis",
            "symbolic-cas",
            "interval-bound",
            "source-citation",
            "unsupported"
          ]
        },
        "backends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/receiptBackend"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replayable": {
          "type": "boolean"
        },
        "proofCheckerBacked": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "receiptBackend": {
      "type": "object",
      "required": ["id", "role", "acceptedProofChecker"],
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "enum": [
            "arithmetic",
            "counterexample-search",
            "checker",
            "cas",
            "retrieval",
            "interval",
            "proof-checker",
            "planned"
          ]
        },
        "version": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "acceptedProofChecker": {
          "type": "boolean"
        }
      }
    },
    "graphNode": {
      "type": "object",
      "required": ["id", "kind", "createdAt", "payload", "trust", "summary", "artifactRefs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^node_[a-f0-9]{16}$"
        },
        "kind": {
          "$ref": "#/$defs/nodeKind"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "payload": true,
        "trust": {
          "$ref": "#/$defs/trustLabel"
        },
        "summary": {
          "type": "string"
        },
        "artifactRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidenceEdge": {
      "type": "object",
      "required": ["from", "to", "label"],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["id", "kind", "mimeType", "content"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^artifact_[a-f0-9]{16}$"
        },
        "kind": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["level", "message"],
      "properties": {
        "level": {
          "enum": ["info", "warning", "error"]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
