{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truth-harness.local/schemas/workspace-revision.schema.json",
  "title": "Truth Harness Workspace Revision",
  "type": "object",
  "required": [
    "schemaVersion",
    "revisionId",
    "projectId",
    "createdAt",
    "title",
    "reason",
    "sourceSnapshot",
    "snapshotRefs",
    "parentRevisionRefs",
    "sessionRefs",
    "validationPlanRefs",
    "claimRefs",
    "artifactRefs",
    "summary",
    "privacy",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "truth-harness.workspace-revision.v0"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^rev_[a-f0-9]{16}$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^(?:tw|th)_[a-f0-9]{16}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string"
    },
    "sourceSnapshot": {
      "type": "object",
      "required": ["snapshotId", "path", "sha256", "totalFiles", "totalBytes"],
      "properties": {
        "snapshotId": {
          "type": "string",
          "pattern": "^snap_[a-f0-9]{16}$"
        },
        "path": {
          "type": "string",
          "pattern": "^\\.truth-harness/snapshots/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "totalFiles": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "snapshotRefs": {
      "$ref": "#/$defs/stringArray"
    },
    "parentRevisionRefs": {
      "$ref": "#/$defs/stringArray"
    },
    "sessionRefs": {
      "$ref": "#/$defs/stringArray"
    },
    "validationPlanRefs": {
      "$ref": "#/$defs/stringArray"
    },
    "claimRefs": {
      "$ref": "#/$defs/stringArray"
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "summary": {
      "type": "object",
      "required": ["totalFiles", "totalBytes", "byKind", "bySchema", "linkedRefs"],
      "properties": {
        "totalFiles": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "byKind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "bySchema": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "linkedRefs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "warnings": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactRef": {
      "type": "object",
      "required": ["path", "role", "source"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.truth-harness/"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sha256Scope": {
          "const": "file"
        },
        "citation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "required": ["mode", "localFirst", "networkAccess", "dataResidency", "externalDisclosures"],
      "properties": {
        "mode": {
          "enum": ["local-only", "external-calls"]
        },
        "localFirst": {
          "const": true
        },
        "networkAccess": {
          "enum": ["none", "optional", "required"]
        },
        "dataResidency": {
          "const": "local-workspace"
        },
        "externalDisclosures": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
