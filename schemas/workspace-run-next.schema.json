{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truth-harness.local/schemas/workspace-run-next.schema.json",
  "title": "Truth Harness Workspace Run-Next Plan",
  "type": "object",
  "required": [
    "schemaVersion",
    "planId",
    "createdAt",
    "workspacePath",
    "localOnly",
    "networkAccess",
    "dryRun",
    "status",
    "mode",
    "reviewId",
    "execution",
    "stopConditions",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "truth-harness.workspace-run-next.v0"
    },
    "planId": {
      "type": "string",
      "pattern": "^wrn_[a-f0-9]{8}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "workspacePath": {
      "type": "string",
      "minLength": 1
    },
    "localOnly": {
      "const": true
    },
    "networkAccess": {
      "const": "none"
    },
    "dryRun": {
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "mode": {
      "enum": ["idle", "local-verifier-loop", "human-review-gated"]
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "item": {
      "type": "object",
      "required": ["itemId", "kind", "priority", "title", "summary", "command"],
      "properties": {
        "itemId": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "validation-gate",
            "route-obligation",
            "route-ready-claim",
            "claim-blocker",
            "report-draft-review",
            "session-task",
            "session-next-check",
            "credibility-action"
          ]
        },
        "priority": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "routeId": { "type": "string" },
        "obligationId": { "type": "string" },
        "obligationKind": { "type": "string" },
        "claimId": { "type": "string" },
        "sessionId": { "type": "string" },
        "validationPlanId": { "type": "string" },
        "validationGateId": { "type": "string" },
        "validationGateKind": { "type": "string" },
        "proofDeclaration": {
          "$ref": "#/$defs/proofDeclaration"
        },
        "proofRepairTarget": {
          "$ref": "#/$defs/proofRepairTarget"
        },
        "proofAttempt": {
          "type": "object",
          "required": ["checkId", "path", "sourcePath", "status", "trust", "createdAt"],
          "properties": {
            "checkId": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "sourcePath": { "type": "string", "minLength": 1 },
            "sourceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceByteLength": { "type": "integer", "minimum": 0 },
            "sourceStatus": {
              "enum": ["unchanged", "changed", "missing", "unchecked"]
            },
            "sourceCurrentSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sourceCurrentByteLength": { "type": "integer", "minimum": 0 },
            "declarationName": { "type": "string" },
            "declaration": {
              "$ref": "#/$defs/proofDeclaration"
            },
            "status": {
              "enum": ["accepted", "rejected", "backend-unavailable", "error"]
            },
            "trust": { "type": "string", "minLength": 1 },
            "createdAt": { "type": "string", "format": "date-time" },
            "diagnosticSnippet": { "type": "string" }
          },
          "additionalProperties": false
        },
        "proofAttemptHistory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proofAttempt"
          }
        },
        "reportId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["status", "kind", "summary"],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string"
        },
        "evidenceRef": {
          "type": "string"
        },
        "attached": {
          "type": "boolean"
        },
        "result": {
          "type": ["object", "array", "string", "number", "boolean", "null"]
        }
      },
      "additionalProperties": false
    },
    "rationale": {
      "type": "object",
      "required": ["target", "source", "executionBoundary"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "candidateEvidenceRef": {
          "type": "string"
        },
        "executionBoundary": {
          "type": "string",
          "minLength": 1
        },
        "firstStopCondition": {
          "type": "string"
        },
        "firstWarning": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "enginePlan": {
      "type": "object",
      "required": [
        "schemaVersion",
        "createdAt",
        "localOnly",
        "networkAccess",
        "problem",
        "normalizedProblem",
        "classifications",
        "status",
        "targetTrustCeiling",
        "recommendedFirstCommand",
        "steps",
        "comparisonMatrix",
        "blockedCapabilityIds",
        "readyCapabilityIds",
        "nextActions",
        "trustBoundary",
        "warnings"
      ],
      "properties": {
        "schemaVersion": {
          "const": "truth-harness.engine-plan.v0"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "localOnly": {
          "const": true
        },
        "networkAccess": {
          "const": "none"
        },
        "problem": {
          "type": "string",
          "minLength": 1
        },
        "normalizedProblem": {
          "type": "string",
          "minLength": 1
        },
        "classifications": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "status": {
          "enum": ["ready-to-route", "route-with-open-gates", "insufficient-engines"]
        },
        "targetTrustCeiling": {
          "type": "string",
          "minLength": 1
        },
        "recommendedFirstCommand": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rank",
              "capabilityId",
              "displayName",
              "role",
              "status",
              "canRunNow",
              "trustIfSuccessful",
              "evidenceRequired",
              "limitation"
            ],
            "properties": {
              "rank": { "type": "integer", "minimum": 1 },
              "capabilityId": { "type": "string", "minLength": 1 },
              "displayName": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "minLength": 1 },
              "canRunNow": { "type": "boolean" },
              "trustIfSuccessful": { "type": "string", "minLength": 1 },
              "command": { "type": "string" },
              "evidenceRequired": { "type": "string", "minLength": 1 },
              "limitation": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "comparisonMatrix": {
          "type": "array",
          "items": { "type": "object" }
        },
        "blockedCapabilityIds": {
          "$ref": "#/$defs/stringArray"
        },
        "readyCapabilityIds": {
          "$ref": "#/$defs/stringArray"
        },
        "nextActions": {
          "$ref": "#/$defs/stringArray"
        },
        "trustBoundary": {
          "type": "object"
        },
        "warnings": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": true
    },
    "idleNextActions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actionId", "title", "command", "reason", "boundary", "requiresHumanInput"],
        "properties": {
          "actionId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "requiresHumanInput": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "required": ["snapshotId", "path", "totalFiles", "totalBytes"],
      "properties": {
        "snapshotId": {
          "type": "string",
          "pattern": "^snap_[a-f0-9]{16}$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "totalFiles": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "sourceRevision": {
      "type": "object",
      "required": ["revisionId", "path", "sourceSnapshotId", "sourceSnapshotPath", "totalFiles", "totalBytes"],
      "properties": {
        "revisionId": {
          "type": "string",
          "pattern": "^rev_[a-f0-9]{16}$"
        },
        "path": {
          "type": "string",
          "pattern": "^\\.truth-harness/revisions/"
        },
        "sourceSnapshotId": {
          "type": "string",
          "pattern": "^snap_[a-f0-9]{16}$"
        },
        "sourceSnapshotPath": {
          "type": "string",
          "pattern": "^\\.truth-harness/snapshots/"
        },
        "totalFiles": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role", "source"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.truth-harness/"
          },
          "role": {
            "enum": [
              "run-next-packet",
              "source-revision",
              "source-snapshot",
              "candidate-evidence",
              "execution-evidence",
              "referenced-artifact"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sha256Scope": {
            "const": "file"
          },
          "citation": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "impactRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["refPath", "citedByPath", "citedByKind", "source"],
        "properties": {
          "refPath": {
            "type": "string",
            "pattern": "^\\.truth-harness/"
          },
          "citedByPath": {
            "type": "string",
            "pattern": "^\\.truth-harness/"
          },
          "citedByKind": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "const": "workspace-catalog"
          },
          "citedByArtifactId": {
            "type": "string"
          },
          "citedByTitle": {
            "type": "string"
          },
          "citedByTrust": {
            "type": "string"
          },
          "citedByStatus": {
            "type": "string"
          },
          "fieldPath": {
            "type": "string"
          },
          "refKind": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "revalidationQueue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "itemId",
          "refPath",
          "dependentPath",
          "dependentKind",
          "source",
          "priority",
          "reason",
          "command",
          "evidenceRequired",
          "boundary"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^reval_[a-f0-9]{8}$"
          },
          "refPath": {
            "type": "string",
            "pattern": "^\\.truth-harness/"
          },
          "dependentPath": {
            "type": "string",
            "pattern": "^\\.truth-harness/"
          },
          "dependentKind": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "const": "impact-ref"
          },
          "priority": {
            "enum": ["high", "medium"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRequired": {
            "type": "string",
            "minLength": 1
          },
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "dependentArtifactId": {
            "type": "string"
          },
          "dependentTitle": {
            "type": "string"
          },
          "dependentTrust": {
            "type": "string"
          },
          "dependentStatus": {
            "type": "string"
          },
          "fieldPath": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "stopConditions": {
      "$ref": "#/$defs/stringArray"
    },
    "warnings": {
      "$ref": "#/$defs/stringArray"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "proofDeclaration": {
      "type": "object",
      "required": [
        "declarationId",
        "kind",
        "path",
        "line",
        "column",
        "signature",
        "signatureSha256",
        "sourceSha256"
      ],
      "properties": {
        "declarationId": {
          "type": "string",
          "pattern": "^decl_[a-f0-9]{16}$"
        },
        "kind": {
          "enum": ["theorem", "lemma", "example", "def"]
        },
        "name": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "signatureSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "proofRepairTarget": {
      "type": "object",
      "required": [
        "repairTargetId",
        "sourcePath",
        "sourceSha256",
        "markerKind",
        "markerLine",
        "markerColumn",
        "afterEditCommands",
        "evidenceRequired",
        "boundary"
      ],
      "properties": {
        "repairTargetId": {
          "type": "string",
          "pattern": "^lpr_[a-f0-9]{16}$"
        },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "markerKind": {
          "enum": ["sorry", "admit", "axiom", "constant", "hole"]
        },
        "markerLine": { "type": "integer", "minimum": 1 },
        "markerColumn": { "type": "integer", "minimum": 1 },
        "declarationId": {
          "type": "string",
          "pattern": "^decl_[a-f0-9]{16}$"
        },
        "declarationName": { "type": "string" },
        "declarationSignatureSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "afterEditCommands": {
          "$ref": "#/$defs/stringArray"
        },
        "evidenceRequired": {
          "$ref": "#/$defs/stringArray"
        },
        "boundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "proofAttempt": {
      "type": "object",
      "required": ["checkId", "path", "sourcePath", "status", "trust", "createdAt"],
      "properties": {
        "checkId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceByteLength": { "type": "integer", "minimum": 0 },
        "sourceStatus": {
          "enum": ["unchanged", "changed", "missing", "unchecked"]
        },
        "sourceCurrentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceCurrentByteLength": { "type": "integer", "minimum": 0 },
        "declarationName": { "type": "string" },
        "declaration": {
          "$ref": "#/$defs/proofDeclaration"
        },
        "status": {
          "enum": ["accepted", "rejected", "backend-unavailable", "error"]
        },
        "trust": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "diagnosticSnippet": { "type": "string" }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": ["planned", "executed", "blocked"]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
