{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truth-harness.local/schemas/workspace-manifest.schema.json",
  "title": "Truth Harness Local Workspace Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "displayName",
    "createdAt",
    "updatedAt",
    "privacy",
    "directories",
    "policies"
  ],
  "properties": {
    "schemaVersion": {
      "const": "truth-harness.workspace.v0"
    },
    "projectId": {
      "type": "string",
      "pattern": "^(?:tw|th)_[a-f0-9]{16}$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "privacy": {
      "type": "object",
      "required": ["mode", "localFirst", "networkAccess", "dataResidency", "externalDisclosures"],
      "properties": {
        "mode": {
          "const": "local-only"
        },
        "localFirst": {
          "const": true
        },
        "networkAccess": {
          "const": "none"
        },
        "dataResidency": {
          "const": "local-workspace"
        },
        "externalDisclosures": {
          "const": []
        }
      },
      "additionalProperties": false
    },
    "directories": {
      "type": "object",
      "required": [
        "receipts",
        "claims",
        "artifacts",
        "events",
        "indexes",
        "findings",
        "inventions",
        "cas",
        "proofs",
        "smt",
        "engine-runs",
        "benchmarks",
        "disclosures",
        "simulations",
        "patents",
        "experiments",
        "vault",
        "audits",
        "snapshots",
        "revisions",
        "sessions",
        "reviews",
        "validation",
        "literature",
        "notebook-runs",
        "code-runs",
        "model-contexts",
        "visuals",
        "routes"
      ],
      "properties": {
        "receipts": {
          "const": ".truth-harness/receipts"
        },
        "claims": {
          "const": ".truth-harness/claims"
        },
        "artifacts": {
          "const": ".truth-harness/artifacts"
        },
        "events": {
          "const": ".truth-harness/events"
        },
        "indexes": {
          "const": ".truth-harness/indexes"
        },
        "findings": {
          "const": ".truth-harness/findings"
        },
        "inventions": {
          "const": ".truth-harness/inventions"
        },
        "cas": {
          "const": ".truth-harness/cas"
        },
        "proofs": {
          "const": ".truth-harness/proofs"
        },
        "smt": {
          "const": ".truth-harness/smt"
        },
        "engine-runs": {
          "const": ".truth-harness/engine-runs"
        },
        "benchmarks": {
          "const": ".truth-harness/benchmarks"
        },
        "disclosures": {
          "const": ".truth-harness/disclosures"
        },
        "simulations": {
          "const": ".truth-harness/simulations"
        },
        "patents": {
          "const": ".truth-harness/patents"
        },
        "experiments": {
          "const": ".truth-harness/experiments"
        },
        "vault": {
          "const": ".truth-harness/vault"
        },
        "audits": {
          "const": ".truth-harness/audits"
        },
        "snapshots": {
          "const": ".truth-harness/snapshots"
        },
        "revisions": {
          "const": ".truth-harness/revisions"
        },
        "sessions": {
          "const": ".truth-harness/sessions"
        },
        "reviews": {
          "const": ".truth-harness/reviews"
        },
        "validation": {
          "const": ".truth-harness/validation"
        },
        "literature": {
          "const": ".truth-harness/literature"
        },
        "notebook-runs": {
          "const": ".truth-harness/notebook-runs"
        },
        "code-runs": {
          "const": ".truth-harness/code-runs"
        },
        "model-contexts": {
          "const": ".truth-harness/model-contexts"
        },
        "visuals": {
          "const": ".truth-harness/visuals"
        },
        "routes": {
          "const": ".truth-harness/routes"
        }
      },
      "additionalProperties": false
    },
    "policies": {
      "type": "object",
      "required": ["externalCalls", "disclosure", "secrets", "portability"],
      "properties": {
        "externalCalls": {
          "const": "disabled-by-default"
        },
        "disclosure": {
          "const": "required-for-external-calls"
        },
        "secrets": {
          "const": "environment-only"
        },
        "portability": {
          "const": "relative-paths"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
